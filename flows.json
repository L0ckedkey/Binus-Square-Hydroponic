        "name": "HTML",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div style=\"display:flex; gap:12px; flex-wrap:wrap;\">\n    <div\n        style=\"flex:1; min-width:140px; padding:12px; border-radius:8px; background:#f5f5f5; border-left:6px solid {{msg.payload.airColor}};\">\n        <div style=\"font-size:12px; color:#777;\">AIR TEMPERATURE</div>\n        <div style=\"font-size:24px; font-weight:bold;\">{{msg.payload.airTemp}}°C</div>\n        <div style=\"color:{{msg.payload.airColor}}; font-weight:bold;\">{{msg.payload.airStatus}}</div>\n    </div>\n    <div\n        style=\"flex:1; min-width:140px; padding:12px; border-radius:8px; background:#f5f5f5; border-left:6px solid {{msg.payload.waterColor}};\">\n        <div style=\"font-size:12px; color:#777;\">WATER TEMPERATURE</div>\n        <div style=\"font-size:24px; font-weight:bold;\">{{msg.payload.waterTemp}}°C</div>\n        <div style=\"color:{{msg.payload.waterColor}}; font-weight:bold;\">{{msg.payload.waterStatus}}</div>\n    </div>\n    <div\n        style=\"flex:1; min-width:140px; padding:12px; border-radius:8px; background:#f5f5f5; border-left:6px solid {{msg.payload.humColor}};\">\n        <div style=\"font-size:12px; color:#777;\">HUMIDITY</div>\n        <div style=\"font-size:24px; font-weight:bold;\">{{msg.payload.humidity}}%</div>\n        <div style=\"color:{{msg.payload.humColor}}; font-weight:bold;\">{{msg.payload.humStatus}}</div>\n    </div>\n</div>",
        "storeOutMessages": true,
