    {
        "id": "8014a2e4dcc0948b",
        "type": "function",
        "z": "d36bb2ccc45e9a57",
        "name": "Evaluate status",
        "func": "function evalStatus(val, min, max) {\n    if (val === undefined || val === null) return { text: \"N/A\", color: \"#9e9e9e\" };\n    if (val < min || val > max) return { text: \"Warning\", color: \"#e53935\" };\n    return { text: \"Normal\", color: \"#43a047\" };\n}\n\nvar airTemp = msg.payload.air_temp_c;\nvar waterTemp = msg.payload.water_temp_c;\nvar humidity = msg.payload.humidity_percent;\n\nvar air = evalStatus(airTemp, 20, 30);\nvar water = evalStatus(waterTemp, 18, 26);\nvar hum = evalStatus(humidity, 50, 70);\n\nmsg.payload = {\n    airTemp: airTemp, airStatus: air.text, airColor: air.color,\n    waterTemp: waterTemp, waterStatus: water.text, waterColor: water.color,\n    humidity: humidity, humStatus: hum.text, humColor: hum.color\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 380,
        "wires": [
            [
                "b1110a6c6087672d"
            ]
        ]
    },
    {
