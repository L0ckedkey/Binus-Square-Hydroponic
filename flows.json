        "func": "var airMsg = { topic: \"Air Temperature\", payload: msg.payload.air_temp_c };\nvar waterMsg = { topic: \"Water Temperature\", payload: msg.payload.water_temp_c };\nreturn [[airMsg, waterMsg]];",
